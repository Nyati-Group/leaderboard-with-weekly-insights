# Copy this file to .env and fill in real values. Never commit the real .env file.

# Database
DATABASE_URL=sqlite:///./dev.db

# Security
SECRET_KEY=change-me-in-production-min-32-chars

# Google Gemini AI (server-side only; never exposed to or configurable from the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
